{
  "name": "Rezepte",
  "short_name": "Rezepte",
  "description": "Rezepte aus Instagram, Facebook & Co. speichern – mit Zutaten, Kalorien, Eiweiß und Zubereitung.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "background_color": "#fbf7f2",
  "theme_color": "#c2410c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
